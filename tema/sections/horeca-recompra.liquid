{%- comment -%}
  Página «Repetir mi pedido». Muestra el último pedido del cliente autenticado y
  un botón para volver a comprarlo. Los datos vienen del backend detrás del App
  Proxy (/apps/asesor/fiscales?recompra=1), que solo devuelve los pedidos del
  cliente con sesión (logged_in_customer_id lo firma Shopify). Sin sesión,
  muestra el enlace para iniciar sesión.
{%- endcomment -%}
<style>
  .hzrc{max-width:720px;margin:0 auto;padding:28px 16px 70px;}
  .hzrc__t{font-size:26px;font-weight:700;color:rgb(var(--color-foreground));margin:0 0 6px;}
  .hzrc__sub{color:rgba(var(--color-foreground),.65);margin:0 0 22px;}
  .hzrc__estado{padding:26px 20px;border:1px solid rgba(var(--color-foreground),.12);border-radius:12px;text-align:center;color:rgba(var(--color-foreground),.72);line-height:1.5;}
  .hzrc__item{display:flex;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid rgba(var(--color-foreground),.1);}
  .hzrc__img{width:58px;height:58px;object-fit:contain;border:1px solid rgba(var(--color-foreground),.1);border-radius:8px;background:#fff;flex:0 0 auto;}
  .hzrc__nom{font-weight:600;font-size:14.5px;line-height:1.3;}
  .hzrc__meta{font-size:13px;color:rgba(var(--color-foreground),.6);margin-top:2px;}
  .hzrc__ago{color:#b91c1c;font-size:12.5px;font-weight:600;margin-top:2px;}
  .hzrc__barra{position:sticky;bottom:0;background:rgb(var(--color-background));padding:16px 0 4px;margin-top:10px;}
  .hzrc__btn{display:block;width:100%;max-width:420px;margin:0 auto;text-align:center;padding:14px;border-radius:999px;background:rgb(var(--color-button));color:rgb(var(--color-button-text));font-weight:700;text-decoration:none;font-size:15px;border:0;cursor:pointer;}
  .hzrc__btn[aria-disabled="true"]{opacity:.5;pointer-events:none;}
  .hzrc__link{color:rgb(var(--color-button));font-weight:600;}
</style>

<div class="hzrc" id="hzrc" data-base="{{ routes.root_url }}">
  <h1 class="hzrc__t">Repetir mi pedido</h1>
  <p class="hzrc__sub">Vuelve a comprar los productos de tu último pedido en un clic.</p>
  <div id="hzrc-cuerpo"><div class="hzrc__estado">Cargando tu último pedido…</div></div>
</div>

<script>
(function () {
  var cuerpo = document.getElementById('hzrc-cuerpo');
  var base = (document.getElementById('hzrc').dataset.base || '/').replace(/\/+$/, '');
  var cuenta = base + '/account';
  function money(v) {
    if (v == null) return '';
    try { return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(Number(v)); }
    catch (e) { return '$' + v; }
  }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }
  fetch('/apps/asesor/fiscales?recompra=1', { headers: { 'Accept': 'application/json' }, credentials: 'include' })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (d && d.sesion === false) {
        cuerpo.innerHTML = '<div class="hzrc__estado">Inicia sesión para ver y repetir tu último pedido.' +
          '<br><br><a class="hzrc__btn" href="' + cuenta + '">Iniciar sesión</a></div>';
        return;
      }
      if (!d || !d.pedido || !d.items || !d.items.length) {
        cuerpo.innerHTML = '<div class="hzrc__estado">Todavía no tienes pedidos para repetir.' +
          '<br><br><a class="hzrc__link" href="' + base + '/collections/all">Ver productos</a></div>';
        return;
      }
      var html = '<p class="hzrc__meta" style="margin:0 0 10px;">Último pedido: <b>' + esc(d.pedido.nombre) + '</b></p>';
      d.items.forEach(function (it) {
        html += '<div class="hzrc__item">' +
          (it.imagen ? '<img class="hzrc__img" src="' + esc(it.imagen) + '" alt="" loading="lazy">' : '<span class="hzrc__img"></span>') +
          '<div style="flex:1;min-width:0;"><div class="hzrc__nom">' + esc(it.titulo) + '</div>' +
          '<div class="hzrc__meta">Cantidad: ' + it.cantidad + (it.precio ? ' · ' + money(it.precio) : '') + '</div>' +
          (it.disponible ? '' : '<div class="hzrc__ago">Agotado — no se agregará</div>') +
          '</div></div>';
      });
      var disponibles = d.items.filter(function (i) { return i.disponible; }).length;
      html += '<div class="hzrc__barra">';
      if (d.carrito && disponibles) {
        html += '<a class="hzrc__btn" href="' + base + d.carrito + '">Volver a comprar (' + disponibles + ')</a>';
      } else {
        html += '<span class="hzrc__btn" aria-disabled="true">Sin productos disponibles para recomprar</span>';
      }
      html += '</div>';
      cuerpo.innerHTML = html;
    })
    .catch(function () {
      cuerpo.innerHTML = '<div class="hzrc__estado">No pudimos cargar tu pedido ahora. Intenta de nuevo en un momento.</div>';
    });
})();
</script>

{% schema %}
{
  "name": "Repetir pedido",
  "settings": [],
  "presets": [{ "name": "Repetir pedido" }]
}
{% endschema %}
